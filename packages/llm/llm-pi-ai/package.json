{
  "name": "@oasisailab/sponge-llm-pi-ai",
  "description": "pi-ai-backed DeepSeek adapter for the Sponge LLM seam (design-verification twin of dsh-llm-deepseek)",
  "version": "0.1.0-rc.8",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/llm/llm-pi-ai"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@oasisailab/sponge-attachment": "workspace:^",
    "@oasisailab/sponge-credentials": "workspace:^",
    "@oasisailab/sponge-launch-environment": "workspace:^",
    "@oasisailab/sponge-invariants": "workspace:^",
    "@oasisailab/sponge-llm": "workspace:^",
    "@oasisailab/sponge-settings": "workspace:^",
    "@oasisailab/sponge-timeout": "workspace:^",
    "@oasisailab/sponge-cordis": "workspace:^"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "^0.82.1",
    "@oasisailab/sponge-schemastery": "workspace:^"
  },
  "devDependencies": {
    "@oasisailab/sponge-attachment": "workspace:^",
    "@oasisailab/sponge-credentials": "workspace:^",
    "@oasisailab/sponge-launch-environment": "workspace:^",
    "@oasisailab/sponge-invariants": "workspace:^",
    "@oasisailab/sponge-llm": "workspace:^",
    "@oasisailab/sponge-llm-deepseek": "workspace:^",
    "@oasisailab/sponge-settings": "workspace:^",
    "@oasisailab/sponge-timeout": "workspace:^",
    "@oasisailab/sponge-cordis": "workspace:^"
  }
}
