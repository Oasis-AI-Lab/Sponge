{
  "name": "@oasisailab/sponge-tool-fs",
  "description": "Model-facing filesystem tools (read, write, edit) over the Sponge filesystem seam (ctx.fs)",
  "version": "0.1.0-rc.8",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/fs/tool-fs"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "diff": "^9.0.0",
    "@oasisailab/sponge-schemastery": "workspace:^"
  },
  "peerDependencies": {
    "@oasisailab/sponge-attachment": "workspace:^",
    "@oasisailab/sponge-fs": "workspace:^",
    "@oasisailab/sponge-invariants": "workspace:^",
    "@oasisailab/sponge-llm": "workspace:^",
    "@oasisailab/sponge-sandbox": "workspace:^",
    "@oasisailab/sponge-sandbox-policy": "workspace:^",
    "@oasisailab/sponge-session": "workspace:^",
    "@oasisailab/sponge-system-prompt": "workspace:^",
    "@oasisailab/sponge-tools": "workspace:^",
    "@oasisailab/sponge-user-approval": "workspace:^",
    "@oasisailab/sponge-cordis": "workspace:^"
  },
  "devDependencies": {
    "@oasisailab/sponge-agent": "workspace:^",
    "@oasisailab/sponge-agent-loop": "workspace:^",
    "@oasisailab/sponge-agent-loop-testkit": "workspace:^",
    "@oasisailab/sponge-attachment": "workspace:^",
    "@oasisailab/sponge-fs": "workspace:^",
    "@oasisailab/sponge-fs-local": "workspace:^",
    "@oasisailab/sponge-fs-observation-policy": "workspace:^",
    "@oasisailab/sponge-invariants": "workspace:^",
    "@oasisailab/sponge-llm": "workspace:^",
    "@oasisailab/sponge-llm-deepseek": "workspace:^",
    "@oasisailab/sponge-sandbox": "workspace:^",
    "@oasisailab/sponge-sandbox-policy": "workspace:^",
    "@oasisailab/sponge-session": "workspace:^",
    "@oasisailab/sponge-system-prompt": "workspace:^",
    "@oasisailab/sponge-tools": "workspace:^",
    "@oasisailab/sponge-user-approval": "workspace:^",
    "@oasisailab/sponge-cordis": "workspace:^"
  }
}
