---
import type { ContentPageData } from "../data/content";

interface Props {
  t: ContentPageData;
}
const { t } = Astro.props;
---
<section class="content-hero">
  <div class="container content-hero-inner">
    <p class="positioning">{t.positioning}</p>
    <span class:list={["badge", t.status.level]}>{t.status.label}</span>
  </div>
</section>

{
  t.blocks.map((block) => (
    <section class="section">
      <div class="container">
        <div class="glass panel">
          <h2>{block.title}</h2>
          {block.body && <p class="lead">{block.body}</p>}
          {block.items && (
            <div class="items">
              {block.items.map((item) => (
                <div class="item">
                  <h3>{item.name}</h3>
                  <p>{item.body}</p>
                </div>
              ))}
            </div>
          )}
        </div>
      </div>
    </section>
  ))
}

<section class="section links-section">
  <div class="container links">
    {t.links.map((link) => (
      <a class="btn" href={link.href}>
        {link.label}
      </a>
    ))}
  </div>
</section>

<style>
  .content-hero {
    padding-top: 5rem;
  }
  .content-hero-inner {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    align-items: flex-start;
  }
  .positioning {
    font-size: clamp(1.5rem, 4vw, 2.4rem);
    font-family: var(--font-display);
    line-height: 1.3;
    letter-spacing: -0.02em;
    max-width: 52rem;
  }
  .badge {
    display: inline-block;
    padding: 0.3rem 0.9rem;
    border-radius: 0;
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    border: 1px solid var(--line);
    background: var(--bg-alt);
    color: var(--ink);
  }
  .badge.stable {
    background: var(--bg);
    box-shadow: var(--shadow-hard-sm);
  }
  .badge.proposal {
    background: var(--ink);
    color: var(--bg);
  }
  .badge.draft {
    border-style: dashed;
  }
  .section {
    padding: 3rem 0 0;
  }
  .panel {
    padding: 2.5rem;
  }
  .panel h2 {
    font-size: 1.6rem;
    margin-bottom: 1rem;
  }
  .lead {
    color: var(--ink-dim);
    max-width: 48rem;
    margin-bottom: 1.75rem;
  }
  .items {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 1.25rem;
  }
  .item {
    padding: 1.4rem 1.5rem;
    border-radius: 0;
    background: var(--bg-alt);
    border: 1px solid var(--line);
    box-shadow: var(--shadow-hard-sm);
  }
  .item h3 {
    font-size: 1.02rem;
    margin-bottom: 0.5rem;
  }
  .item p {
    color: var(--ink-dim);
    font-size: 0.92rem;
  }
  .links-section {
    padding-bottom: 2rem;
  }
  .links {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
  }
</style>
