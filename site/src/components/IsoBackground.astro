---
// Isometric background: 30° grid + floating wireframe/solid cubes.
// CSS + inline SVG, zero JS. Respects prefers-reduced-motion.
---
<div class="iso-bg" aria-hidden="true">
  <div class="iso-grid"></div>
  <div class="iso-cube c1">
    <svg viewBox="0 0 100 100" xmlns="http://www.w3.org/2000/svg">
      <polygon points="50,0 100,25 50,50 0,25" fill="#ffffff" stroke="#111111" stroke-width="2" />
      <polygon points="0,25 50,50 50,100 0,75" fill="#e0e0e0" stroke="#111111" stroke-width="2" />
      <polygon points="100,25 50,50 50,100 100,75" fill="#b3b3b3" stroke="#111111" stroke-width="2" />
    </svg>
  </div>
  <div class="iso-cube c2">
    <svg viewBox="0 0 100 100" xmlns="http://www.w3.org/2000/svg">
      <polygon points="50,0 100,25 50,50 0,25" fill="#d9d9d9" stroke="#111111" stroke-width="2" />
      <polygon points="0,25 50,50 50,100 0,75" fill="#a6a6a6" stroke="#111111" stroke-width="2" />
      <polygon points="100,25 50,50 50,100 100,75" fill="#737373" stroke="#111111" stroke-width="2" />
    </svg>
  </div>
  <div class="iso-cube c3">
    <svg viewBox="0 0 100 100" xmlns="http://www.w3.org/2000/svg">
      <polygon points="50,0 100,25 50,50 0,25" fill="#b3b3b3" stroke="#111111" stroke-width="2" />
      <polygon points="0,25 50,50 50,100 0,75" fill="#8a8a8a" stroke="#111111" stroke-width="2" />
      <polygon points="100,25 50,50 50,100 100,75" fill="#555555" stroke="#111111" stroke-width="2" />
    </svg>
  </div>
  <div class="iso-cube c4">
    <svg viewBox="0 0 100 100" xmlns="http://www.w3.org/2000/svg">
      <polygon points="50,0 100,25 50,50 0,25" fill="none" stroke="#111111" stroke-width="2" />
      <polygon points="0,25 50,50 50,100 0,75" fill="none" stroke="#111111" stroke-width="2" />
      <polygon points="100,25 50,50 50,100 100,75" fill="none" stroke="#111111" stroke-width="2" />
    </svg>
  </div>
</div>

<style>
  .iso-bg {
    position: fixed;
    inset: 0;
    z-index: -1;
    overflow: hidden;
    background: var(--bg);
  }
  .iso-grid {
    position: absolute;
    inset: 0;
    background-image:
      repeating-linear-gradient(30deg, var(--grid) 0 1px, transparent 1px 26px),
      repeating-linear-gradient(-30deg, var(--grid) 0 1px, transparent 1px 26px);
    mask-image: linear-gradient(to bottom, rgba(0, 0, 0, 0.9), rgba(0, 0, 0, 0.25));
    -webkit-mask-image: linear-gradient(to bottom, rgba(0, 0, 0, 0.9), rgba(0, 0, 0, 0.25));
  }
  .iso-cube {
    position: absolute;
    opacity: 0.9;
    will-change: transform;
  }
  .iso-cube svg {
    display: block;
    width: 100%;
    height: 100%;
  }
  .c1 {
    width: 200px;
    height: 200px;
    top: 14%;
    right: 8%;
    animation: float1 18s ease-in-out infinite alternate;
  }
  .c2 {
    width: 120px;
    height: 120px;
    top: 58%;
    left: 6%;
    animation: float2 22s ease-in-out infinite alternate;
  }
  .c3 {
    width: 90px;
    height: 90px;
    top: 30%;
    left: 16%;
    animation: float3 26s ease-in-out infinite alternate;
  }
  .c4 {
    width: 150px;
    height: 150px;
    bottom: 10%;
    right: 20%;
    animation: float4 20s ease-in-out infinite alternate;
  }
  @keyframes float1 {
    from { transform: translate(0, 0); }
    to { transform: translate(-24px, 18px); }
  }
  @keyframes float2 {
    from { transform: translate(0, 0); }
    to { transform: translate(18px, -22px); }
  }
  @keyframes float3 {
    from { transform: translate(0, 0); }
    to { transform: translate(-14px, -16px); }
  }
  @keyframes float4 {
    from { transform: translate(0, 0); }
    to { transform: translate(20px, 14px); }
  }
  @media (prefers-reduced-motion: reduce) {
    .iso-cube { animation: none; }
  }
</style>
