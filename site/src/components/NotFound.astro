---
interface Props {
  code: string;
  msg: string;
  home: string;
  href: string;
}
const { code, msg, home, href } = Astro.props;
---
<section class="nf">
  <div class="container nf-inner">
    <h1 class="code">{code}</h1>
    <p class="msg" id="nf-msg">{msg}</p>
    <a class="btn primary" href={href} id="nf-home">
      {home}
    </a>
  </div>
</section>

<style>
  .nf {
    display: flex;
    align-items: center;
    min-height: 68vh;
  }
  .nf-inner {
    text-align: center;
  }
  .code {
    display: inline-block;
    font-size: clamp(4rem, 14vw, 9rem);
    font-weight: 700;
    color: var(--ink);
    letter-spacing: -0.04em;
    padding: 0 0.2em;
    border: 2px solid var(--line);
    box-shadow: var(--shadow-hard);
    background: var(--bg);
    margin-bottom: 1.25rem;
  }
  .msg {
    color: var(--ink-dim);
    font-size: 1.15rem;
    margin-bottom: 2rem;
  }
</style>